# AI Daily Job Application Automation System Configuration

# Environment mode: development / production
APP_ENV=development

# Database path (SQLite)
DATABASE_PATH=candidate_jobs.db

# Matching Settings
MIN_MATCH_SCORE=70
EXP_MAX_YEARS_TOLERANCE=2.0
MIN_SALARY_LPA=6.0
MAX_SALARY_LPA=10.0

# Scheduler Settings (24-hour format IST)
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata

# Discovery Settings
DISCOVERY_MOCK_FALLBACK=true
MAX_JOBS_PER_PLATFORM=25

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
DRY_RUN_APPLICATIONS=true

# Notification Settings
NOTIFY_CONSOLE=true
NOTIFY_FILE=true
REPORTS_DIR=reports
